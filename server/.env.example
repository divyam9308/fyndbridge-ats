# Backend server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase (server only)
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Public Open Roles application security (required in production)
PUBLIC_APPLICATION_RATE_LIMIT_SALT=GENERATE_A_LONG_RANDOM_SECRET
PUBLIC_APPLICATION_FORM_TOKEN_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY_HERE

# Public application limits (optional; defaults shown)
PUBLIC_APPLICATION_MIN_COMPLETION_MS=3000
PUBLIC_APPLICATION_FORM_TOKEN_MAX_AGE_MS=7200000
PUBLIC_APPLICATION_PARSE_RATE_LIMIT=10
PUBLIC_APPLICATION_PARSE_RATE_WINDOW_SECONDS=900
PUBLIC_APPLICATION_SUBMIT_RATE_LIMIT=5
PUBLIC_APPLICATION_SUBMIT_RATE_WINDOW_SECONDS=3600
PUBLIC_APPLICATION_CONVERSION_STALE_MS=900000

# Local development only. Ignored when NODE_ENV=production.
PUBLIC_APPLICATION_ALLOW_UNSAFE_DEV=false

# Gemini AI
GEMINI_API_KEY_PRIMARY=YOUR_GEMINI_API_KEY_PRIMARY_HERE
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.1-flash-lite

# GST lookup
GST_LOOKUP_PROVIDER=
GSTINCHECK_API_KEY=
GST_LOOKUP_TIMEOUT_MS=10000

# Backend diagnostics and scripts
DEBUG_PERF=false
ALLOW_DEMO_RESET=false
