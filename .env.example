# Frontend (Vite)
# These values are exposed to the browser. Keep server-only secrets in server/.env.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Cloudflare Turnstile public site key for Public Open Roles applications.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE

# Frontend diagnostics
# Set to true only when you want request timing logs in the browser console.
VITE_DEBUG_PERF=false
