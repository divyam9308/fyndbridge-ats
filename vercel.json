{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && cd server && npm install",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "server/{eng.traineddata,node_modules/{pdfjs-dist/legacy/build/pdf.worker.mjs,{tesseract.js,tesseract.js-core,node-fetch,is-url,regenerator-runtime,wasm-feature-detect,node-readable-to-web-readable-stream,@napi-rs/canvas*}/**/*}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
